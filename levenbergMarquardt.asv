function [x,resnorm,r] = levmarq(func,x0, options)
    % The idea of L-M is to update the parameters x0 to better fit the
    % data. This is done by simplifying the second gradient of func with
    % respect to x by replacing the sum with a simple scaled identity
    % matrix.
    
    if nargin < 3
        options = struct(); 
    end
    if ischar(func) || isstring(func)
        func = str2func(func); % convert text to function
    end
    if isfield(options, 'Jacobian')
        useGrad = strcmpi(options.Jacobian,'on'); % if we should estimate the jacobian or not
    else
        useGrad = nargout(func) >= 2; % assume second value from func is the gradient
    end
    if isfield(options, 'tol')
        tol = options.tol;
    else
        tol = 1e-10; % default tolerance
    end

    if isfield(options, 'maxIter')
        maxIter = options.maxIter;
    else
        maxIter = 200; % default max number of iterations
    end

    % func = F(x) = (f1(x), f2(x),..., fm(x))^T, m = # samples

    % First we need the gradient of F, we use second-order cental finite difference
    % df/dxi = (f(x+h e_i) - f(x-h e_i))/2h
    
    % Func is a column vector of f1,... fm   

    x = x0;
    r = res(x); 
    m = length(r);
    n = length(x0);

    prev_resnorm = Inf;
    resnorm = r.' * r;
    nrIterations = 0;

    lambda = 1; % damping factor
    while abs(resnorm-prev_resnorm) > tol  && nrIterations < maxIter
        jacobian = grad(x);
        assert(isequal(size(jacobian), [n,m]), 'Supplied gradient must be of size %dx%d',n,m); % we require correct size

        JTJ = jacobian * jacobian.';
        %norm_jtj = norm(JTJ);

        LH = JTJ + lambda*eye(n); % times p
        RH = -jacobian * r;
        p = LH \ RH;
        % we trial 
        x = x + p;

        prev_resnorm = resnorm;
        r = res(x);
        resnorm = sum(r.'*r);
        % Check if next step reduces the overall error
        if resnorm < prev_resnorm
            lambda = lambda/10; % reduce damping 
        else
            lambda = lambda*10; % increase damping
            % reject step as our error increased
            x = x-p;

        end
        nrIterations = nrIterations+ 1;
    end

    function r = res(x)
         r = func(x);
         r = r(:);
    end
    function G = grad(x)
        if useGrad
            [~,G] = func(x);
        else
            % central difference approximation of the gradient of x
            for i = n:-1:1 % reverse loop over each parameter of x
                h = eps^(1/3)*max(1,abs(x(i))); % eps(1/3) = smallest possible distance from 1/3
                e = zeros(n,1);
                e(i) = h;
                d = func(x+e) - func(x-e); 
                G(i,:) = d(:).' /(2*h); 
            end
        end
    end
end




% 2, example func y(t) = x_1 e^(x_2 t)
function [F] = getObjectiveFunction(x)
    ti = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0];
    yi = [7.2, 3.0, 1.5, 0.85, 0.48, 0.25, 0.20, 0.15];
    F = (x(1)*exp(x(2)*ti) - yi).';
end


function [err] = totalErr(x)
    err = sum(getObjectiveFunction(x));
end


function plot_func(x)
    ti = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0];
    yi = [7.2, 3.0, 1.5, 0.85, 0.48, 0.25, 0.20, 0.15];

    t = linspace(0,5,100);
    y = x(1)*exp(x(2)*t);

    scatter(ti, yi, 'filled')
    hold on
    plot(t, y, '-r', 'LineWidth',1.5)
    hold off
    xlabel('t')
    ylabel('y')
    legend('Given data', 'Fitted curve')

end

function plt_comparison(x,x_opt)
    ti = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0];
    yi = [7.2, 3.0, 1.5, 0.85, 0.48, 0.25, 0.20, 0.15];

    t = linspace(0,5,100);
    y = x(1)*exp(x(2)*t);
    y_opt = x_opt(1)*exp(x_opt(2)*t);

    scatter(ti, yi, 'filled')
    hold on
    plot(t, y, '-r', 'LineWidth',1.5, 'Color','r')
    plot(t, y_opt, '-r', 'LineWidth',1.5, 'Color','b')
    hold off
    xlabel('t')
    ylabel('y')
    legend('Given data', 'Fitted curve (LM)', 'Fitted curve (LSQCurveFit)')

end
ti = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0];
yi = [7.2, 3.0, 1.5, 0.85, 0.48, 0.25, 0.20, 0.15];
F = @(x,t) x(1) * exp(x(2)*t);

x0 = [1,1].'; %starting guess

[x,resnorm,residual]  = levmarq(@getObjectiveFunction, x0);


% matlab built in solver:
x_opt = lsqcurvefit(F, x0,ti, yi);

%plot_func(x)
diff = sum(abs(x-x_opt));
plt_comparison(x,x_opt)

